{
  "name": "@bfl/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Black Forest Labs API",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "lint": "biome check",
    "fix": "biome check --write",
    "test": "vitest run",
    "test:deno": "tsdown && deno test --no-lock test/deno/",
    "examples:update-sdk": "pnpm --dir examples/vercel_next sdk:update && pnpm --dir examples/supabase_react sdk:update && pnpm --dir examples/node_script sdk:update"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@types/node": "^22.20.4",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.1.0"
  }
}
